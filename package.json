{
  "name": "youtube-api-proxy",
  "version": "2.0.0",
  "description": "Proxy for the YouTube API for additional rate limiting and keeping your key secret",
  "engines": {
    "node": "26.x"
  },
  "main": "src/server.mjs",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "keywords": [
    "youtube",
    "youtube-api",
    "proxy"
  ],
  "author": "mattwright324",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.9",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "node-cache": "^5.1.2"
  }
}
