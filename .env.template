# Comma delimited list
CORS_WHITELIST=http://localhost:4000
# Usage limits: LIMIT_<SCOPE>_<METRIC>_<WINDOW>
# Set LIMIT_DRY_RUN=true to only log "WARN Limit exceeded" without blocking, useful while tuning.
LIMIT_DRY_RUN=
LIMIT_IP_REQUESTS_MINUTE=152
LIMIT_IP_REQUESTS_DAY=0
LIMIT_IP_UNITS_MINUTE=0
LIMIT_IP_UNITS_DAY=20000
LIMIT_IP_SEARCH_MINUTE=20
LIMIT_IP_SEARCH_DAY=500
LIMIT_BLOCK_REQUESTS_MINUTE=600
LIMIT_BLOCK_REQUESTS_DAY=0
LIMIT_BLOCK_UNITS_MINUTE=0
LIMIT_BLOCK_UNITS_DAY=60000
LIMIT_BLOCK_SEARCH_MINUTE=50
LIMIT_BLOCK_SEARCH_DAY=1500
LIMIT_GLOBAL_REQUESTS_MINUTE=0
LIMIT_GLOBAL_REQUESTS_DAY=0
LIMIT_GLOBAL_UNITS_MINUTE=1440
LIMIT_GLOBAL_UNITS_DAY=950000
LIMIT_GLOBAL_SEARCH_MINUTE=190
LIMIT_GLOBAL_SEARCH_DAY=18000
LIMIT_DISTINCT_PARAM=
LIMIT_DISTINCT_MIN_REQUESTS=1000
LIMIT_DISTINCT_MAX_RATIO=0.5
# Response cache time
CACHE_TTL_SEC=300
# Timeout for requests to YouTube (default 10000)
UPSTREAM_TIMEOUT_MS=10000
# Create your own key in the Google Developers Console
# https://console.cloud.google.com/apis/dashboard
API_V3_KEY=
INNERTUBE_CLIENT_VERSION=2.20261116.00.00
# Comma delimited lists -or- use * for all
# https://developers.google.com/youtube/v3/docs
API_ALLOWED_PATHS=videos,channels,playlists,playlistItems,search
API_ALLOWED_PARAMS=id,part,maxResults,pageToken,forUsername,channelId,playlistId,q,type,locationRadius,location,publishedBefore,publishedAfter,relevanceLanguage,eventType,videoLicense,videoDefinition,videoDimension,order,safeSearch,videoPaidProductPlacement
# Optional monitoring page with basic auth. Enabled only when all three are set.
MONITOR_PATH=/monitor
MONITOR_USER=admin
MONITOR_PASSWORD=
# Optional
SCRIPT_EXPECTED_PARAMS=
SCRIPT_UA_PATTERNS=
# Network (ASN) lookups from https://iptoasn.com
ASN_LOOKUP=true
ASN_DATA_DIR=./data
# Logging: LOG_LEVEL is debug, info, warn or error. LOG_FORMAT is text or json.
LOG_LEVEL=info
LOG_FORMAT=text
# Database configuration optional
PG_HOST=
PG_PORT=
PG_USER=
PG_PASS=
PG_DBNAME=
PG_SCHEMA=
